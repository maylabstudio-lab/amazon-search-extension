{
  "manifest_version": 3,
  "name": "Amazon Search Filter",
  "version": "1.0.0",
  "description": "Amazonの検索条件（発送元・割引率など）をワンクリックで適用します。",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.example.com/*"],
  "background": {
    "service_worker": "background.js"
  }
}